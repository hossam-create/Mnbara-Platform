generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  plan      String
  isActive  Boolean  @default(true)
  expiresAt DateTime
  features  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

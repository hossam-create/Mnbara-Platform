# ============================================
# Cart Service Configuration
# ============================================
# Canonical Port: 3013

NODE_ENV=development
PORT=3013

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/cart_db

# Redis Cache (cart sessions)
REDIS_URL=redis://localhost:6379

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (must match auth-service)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# INTERNAL SERVICE URLS (canonical ports)
# ============================================
PRODUCT_SERVICE_URL=http://localhost:3004

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

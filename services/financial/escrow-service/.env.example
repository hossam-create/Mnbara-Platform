# Escrow Service Configuration

# Environment
NODE_ENV=development
PORT=3007

# Database
DATABASE_URL=postgresql://mnbara:password@localhost:5432/escrow_db

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
WALLET_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3003

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Escrow Configuration
ESCROW_HOLD_TIMEOUT=7200000
ESCROW_DISPUTE_TIMEOUT=604800000
ESCROW_RELEASE_BUFFER=300000

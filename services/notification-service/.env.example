# ============================================
# Notification Service Configuration
# ============================================
# Canonical Port: 3011

NODE_ENV=development
PORT=3011

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/notification_db

# Redis Cache
REDIS_URL=redis://localhost:6379

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (must match auth-service)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# EMAIL (SendGrid)
# ============================================
SENDGRID_API_KEY=CHANGE_ME
FROM_EMAIL=noreply@mnbarh.com

# ============================================
# SMS (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PUSH NOTIFICATIONS (Firebase)
# ============================================
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_PRIVATE_KEY=CHANGE_ME

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

# ============================================
# API Gateway Configuration
# ============================================
# Canonical Port: 3000

NODE_ENV=development
PORT=3000

# Redis Cache
REDIS_URL=redis://localhost:6379

# CORS - comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=15m

# ============================================
# SERVICE REGISTRY (Activity Aggregation)
# ============================================
# These services are used by the Activity Aggregation endpoint

WALLET_SERVICE_URL=http://localhost:3006
TRAVELER_SERVICE_URL=http://localhost:3007
MARKETPLACE_SERVICE_URL=http://localhost:3008

# ============================================
# Other Services
# ============================================
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
DELIVERY_SERVICE_URL=http://localhost:3005

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# KAFKA (Real-Time Activity Streaming)
# ============================================
# Comma-separated list of Kafka brokers
KAFKA_BROKERS=localhost:9092

# Consumer group ID for activity events
KAFKA_ACTIVITY_GROUP_ID=activity-gateway-consumer

# Enable SSL for production
KAFKA_SSL=false

# SASL Authentication (leave empty for no auth)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ============================================
# WEBSOCKET RATE LIMITING
# ============================================
# Max connection attempts per minute per IP
WS_RATE_LIMIT_MAX_ATTEMPTS=10
WS_RATE_LIMIT_WINDOW_MS=60000


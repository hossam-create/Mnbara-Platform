# ============================================
# Matching Service Configuration
# ============================================
# Canonical Port: 3010

NODE_ENV=development
PORT=3010

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/matching_db

# Redis Cache
REDIS_URL=redis://localhost:6379

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (must match auth-service)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# INTERNAL SERVICE URLS (canonical ports)
# ============================================
PRODUCT_SERVICE_URL=http://localhost:3004
TRIPS_SERVICE_URL=http://localhost:3009
COUNTRY_LAYER_SERVICE_URL=http://localhost:3016

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

# ============================================================================
# User Service Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

# Service Port
PORT=3002

# Node Environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL
DATABASE_URL="postgresql://mnbara:password@localhost:5432/mnbara_user_service"

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=24h
JWT_ALGORITHM=HS256

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_MAX_AGE=86400000

# Password Hashing
BCRYPT_ROUNDS=10

# ============================================================================
# CORS & SECURITY HEADERS
# ============================================================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# LOGGING
# ============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Log Format (json, text)
LOG_FORMAT=json

# ============================================================================
# SERVICE DISCOVERY
# ============================================================================

# Auth Service
AUTH_SERVICE_URL=http://localhost:3004

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:3003

# API Gateway
API_GATEWAY_URL=http://localhost:3000

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# AWS S3 Storage (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mnbara-uploads

# SendGrid Email Service (optional)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@mnbara.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Debug Endpoints
ENABLE_DEBUG_ENDPOINTS=false

# Enable Swagger Documentation
ENABLE_SWAGGER_DOCS=true

# ============================================================================
# ENCRYPTION
# ============================================================================

# Encryption Key for sensitive data
ENCRYPTION_KEY=your-encryption-key-32-chars-min
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate Limit Window (milliseconds)
RATE_LIMIT_WINDOW_MS=900000

# Rate Limit Max Requests
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# PROFILE & AVATAR CONFIGURATION
# ============================================================================

# Max Avatar Upload Size (in bytes)
MAX_AVATAR_SIZE=5242880

# Allowed Avatar Formats
ALLOWED_AVATAR_FORMATS=jpg,jpeg,png,webp

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. Update all "your_*_here" placeholders with actual values
# 3. Use strong, unique secrets for production environments
# 4. Rotate secrets regularly in production
# 5. Ensure DATABASE_URL points to the correct database instance

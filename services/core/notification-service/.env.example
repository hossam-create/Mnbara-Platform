# ============================================================================
# Notification Service Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

# Service Port
PORT=3003

# Node Environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL
DATABASE_URL="postgresql://mnbara:password@localhost:5432/mnbara_notification_service"

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=24h
JWT_ALGORITHM=HS256

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_MAX_AGE=86400000

# ============================================================================
# CORS & SECURITY HEADERS
# ============================================================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# LOGGING
# ============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Log Format (json, text)
LOG_FORMAT=json

# ============================================================================
# SERVICE DISCOVERY
# ============================================================================

# Auth Service
AUTH_SERVICE_URL=http://localhost:3004

# User Service
USER_SERVICE_URL=http://localhost:3002

# API Gateway
API_GATEWAY_URL=http://localhost:3000

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@mnbara.com
SMTP_FROM_NAME=Mnbara Platform

# SendGrid Email Service (alternative to SMTP)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@mnbara.com
SENDGRID_FROM_NAME=Mnbara Platform

# ============================================================================
# SMS CONFIGURATION (Twilio)
# ============================================================================

# Twilio Account Configuration
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# PUSH NOTIFICATIONS (Firebase)
# ============================================================================

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email@iam.gserviceaccount.com

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

# WebSocket Server
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3003
WEBSOCKET_PATH=/socket.io

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================

# Notification Retention (in days)
NOTIFICATION_RETENTION_DAYS=30

# Batch Notification Settings
BATCH_NOTIFICATIONS_ENABLED=true
BATCH_NOTIFICATION_DELAY_MS=5000
BATCH_NOTIFICATION_SIZE=10

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Debug Endpoints
ENABLE_DEBUG_ENDPOINTS=false

# Enable Swagger Documentation
ENABLE_SWAGGER_DOCS=true

# Notification Channels
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_WEBSOCKET_NOTIFICATIONS=true

# ============================================================================
# ENCRYPTION
# ============================================================================

# Encryption Key for sensitive data
ENCRYPTION_KEY=your-encryption-key-32-chars-min
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate Limit Window (milliseconds)
RATE_LIMIT_WINDOW_MS=900000

# Rate Limit Max Requests
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# QUEUE CONFIGURATION (Optional - for async notifications)
# ============================================================================

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. Update all "your_*_here" placeholders with actual values
# 3. Use strong, unique secrets for production environments
# 4. Rotate secrets regularly in production
# 5. Ensure DATABASE_URL points to the correct database instance
# 6. For email notifications, use either SMTP or SendGrid (not both)
# 7. SMS and Push notifications are optional - disable if not needed

# ============================================================================
# Auth Service Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

# Service Port
PORT=3004

# Node Environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL
DATABASE_URL="postgresql://mnbara:password@localhost:5432/mnbara_auth"

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRY=24h
JWT_ALGORITHM=HS256

# Refresh Token Configuration
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production-min-32-chars
REFRESH_TOKEN_EXPIRY=7d

# Password Hashing
BCRYPT_ROUNDS=10

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_MAX_AGE=86400000

# ============================================================================
# CORS & SECURITY HEADERS
# ============================================================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# LOGGING
# ============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Log Format (json, text)
LOG_FORMAT=json

# ============================================================================
# SERVICE DISCOVERY
# ============================================================================

# User Service
USER_SERVICE_URL=http://localhost:3002

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:3003

# API Gateway
API_GATEWAY_URL=http://localhost:3000

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# Stripe Payment Gateway (optional)
STRIPE_SECRET_KEY=sk_test_your_key_here

# SendGrid Email Service (optional)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@mnbara.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Debug Endpoints
ENABLE_DEBUG_ENDPOINTS=false

# Enable Swagger Documentation
ENABLE_SWAGGER_DOCS=true

# ============================================================================
# ENCRYPTION
# ============================================================================

# Encryption Key for sensitive data
ENCRYPTION_KEY=your-encryption-key-32-chars-min
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate Limit Window (milliseconds)
RATE_LIMIT_WINDOW_MS=900000

# Rate Limit Max Requests
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. Update all "your_*_here" placeholders with actual values
# 3. Use strong, unique secrets for production environments
# 4. Rotate secrets regularly in production
# 5. Ensure DATABASE_URL points to the correct database instance

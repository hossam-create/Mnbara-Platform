{
  "name": "@mnbara/auth-service",
  "version": "1.0.0",
  "description": "Authentication and authorization service for Mnbara platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seeds/seed.ts"
  },
  "dependencies": {
    "@mnbara/types": "file:../../../packages/types",
    "@mnbara/utils": "file:../../../packages/utils",
    "@mnbara/validation": "file:../../../packages/validation",
    "@mnbara/api-client": "file:../../../packages/api-client",
    "express": "^4.18.2",
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prisma": "^5.7.1"
  }

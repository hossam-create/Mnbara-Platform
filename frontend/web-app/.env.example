# API Configuration (use API Gateway in production)
VITE_API_BASE_URL=http://localhost:8080
VITE_SOCKET_URL=http://localhost:8080

# Mnbarh Live (eBay Live) – backend for /live page (streams, chat, auctions)
# Dev: point to ebay-live-service. Production: use API Gateway URL.
REACT_APP_LIVE_SERVICE_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false
VITE_ENABLE_PWA=true

# External Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_STRIPE_PUBLISHABLE_KEY=

# Social Auth
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_APPLE_CLIENT_ID=

# Map Services
VITE_GOOGLE_MAPS_API_KEY=

# CDN
VITE_CDN_URL=https://cdn.mnbara.com
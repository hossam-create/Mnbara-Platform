#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit security checks..."

# Check for common secret patterns
PATTERNS=(
    "PRIVATE_KEY"
    "API_KEY"
    "SECRET_KEY"
    "PASSWORD"
    "TOKEN"
    "AWS_SECRET"
    "DATABASE_URL"
    "JWT_SECRET"
)

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check each pattern
for pattern in "${PATTERNS[@]}"; do
    if git diff --cached | grep -i "$pattern" | grep -v ".env.example" > /dev/null 2>&1; then
        echo "❌ ERROR: Potential secret detected: $pattern"
        echo "   Please remove secrets before committing"
        exit 1
    fi
done

# Check for .env files
if git diff --cached --name-only | grep -E "\.env($|\.)" | grep -v ".env.example" > /dev/null 2>&1; then
    echo "❌ ERROR: .env file detected in staged changes"
    echo "   .env files should never be committed"
    exit 1
fi

# Check for private keys
if git diff --cached --name-only | grep -E "\.(pem|key|p8|p12|pfx|jks)$" > /dev/null 2>&1; then
    echo "❌ ERROR: Private key file detected"
    echo "   Private keys should never be committed"
    exit 1
fi

echo "✅ Pre-commit checks passed"
exit 0

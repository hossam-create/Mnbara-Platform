# GeoLock Service Environment Variables
# متغيرات بيئة خدمة GeoLock

# Server
PORT=3022
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mnbara_geolock?schema=public"

# Redis (for caching and geofencing)
REDIS_URL="redis://localhost:6379"

# External APIs (optional)
IP_API_URL="https://ipapi.co/json/"
MAXMIND_LICENSE_KEY="your-maxmind-license-key"

# JWT
JWT_SECRET="your-jwt-secret-key"

# Geofencing
GEOFENCE_CHECK_INTERVAL=30000
AIRPORT_DATA_SOURCE="ourairports"

# Notifications
NOTIFICATION_SERVICE_URL="http://localhost:3007"

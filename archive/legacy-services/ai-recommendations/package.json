    "@prisma/client": "^5.22.0",
    "axios": "^1.6.2",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.0",
    "@tensorflow/tfjs-node": "^4.10.0",
    "natural": "^6.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",

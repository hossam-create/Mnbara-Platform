# CrafterCMS Content Service Environment Configuration

# Server Configuration
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# CrafterCMS Configuration
CRAFTER_STUDIO_URL=http://localhost:8080
CRAFTER_ENGINE_URL=http://localhost:8081
CRAFTER_AUTH_TOKEN=your-crafter-auth-token

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Database Configuration (for content sync)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/mnbara

# Authentication Configuration
JWT_SECRET=your-jwt-secret-key-minimum-32-characters
API_KEY=your-api-key-for-service-communication

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key

# External Services
WEBHOOK_SECRET=your-webhook-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Security Configuration
ENCRYPTION_KEY=your-encryption-key-32-characters-min
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_AGE=3600

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Content Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ar,zh
CONTENT_PREVIEW_URL=http://localhost:8081/preview

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
ANALYTICS_ENABLED=true

# Development Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
DEBUG_MODE=false

# Production Configuration (uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=warn
# DEBUG_MODE=false
# CORS_ORIGIN=https://yourdomain.com
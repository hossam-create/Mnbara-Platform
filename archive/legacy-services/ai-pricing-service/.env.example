# AI Pricing Service Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3040
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mnbara_pricing

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# External Services
# COMPETITOR_API_KEY=
# MARKET_DATA_API_URL=

# Server Configuration
PORT=3012
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mnbara_task_scheduler?schema=public"

# Logging
LOG_LEVEL=info

# Task Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_CHECK_INTERVAL=60000  # 1 minute in ms

# External Services (for plugins)
OPENEXCHANGERATES_API_KEY=your_api_key_here
NOTIFICATION_SERVICE_URL=http://localhost:3001/api/v1/notifications
AUCTION_SERVICE_URL=http://localhost:3002/api/v1/auctions

# Email (for report plugin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

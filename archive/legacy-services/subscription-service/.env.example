# Subscription Service Configuration
NODE_ENV=development
PORT=3025

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/mnbara_subscriptions

# JWT Configuration
JWT_SECRET=your-subscription-service-jwt-secret-change-this
JWT_EXPIRES_IN=24h

# Security Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Feature Configuration
DEFAULT_FREE_FEATURES=create-product,browse-products,basic-search
DEFAULT_BASIC_FEATURES=create-product,browse-products,basic-search,send-messages
DEFAULT_PREMIUM_FEATURES=create-product,browse-products,basic-search,send-messages,request-item-from-traveler,priority-support,advanced-analytics
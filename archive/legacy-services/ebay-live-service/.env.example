# Application Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://ebay_live_user:secure_password_123@localhost:5432/ebay_live_db
DB_PASSWORD=secure_password_123

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# RTMP Configuration
RTMP_SECRET=your_rtmp_secret_here
RTMP_PORT=1935

# HLS Configuration
HLS_OUTPUT_DIR=./media/hls
HLS_SEGMENT_DURATION=6
HLS_LIST_SIZE=5

# WebRTC Configuration
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Media Configuration
MEDIA_STORAGE_PATH=./media
MAX_FILE_SIZE=1073741824 # 1GB in bytes
ALLOWED_VIDEO_FORMATS=mp4,mkv,avi,mov,flv
ALLOWED_AUDIO_FORMATS=mp3,wav,aac,flac

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Streaming Configuration
MAX_CONCURRENT_STREAMS=100
MAX_VIEWERS_PER_STREAM=10000
STREAM_TIMEOUT_MS=30000
CHAT_RATE_LIMIT=10 # messages per second

# Auction Configuration
AUCTION_MIN_BID_INCREMENT=1.0
AUCTION_AUTO_EXTEND_TIME=300 # 5 minutes
AUCTION_PAYMENT_TIMEOUT=1800 # 30 minutes
AUCTION_MAX_BIDS_PER_USER=10
AUCTION_ANTI_SNIPE_TIME=60 # 1 minute

# Optional: notify platform when live auction payment is submitted (create order / capture)
# Use API Gateway URL so request reaches orders-service. Example (gateway on port 8080):
# LIVE_ORDER_CALLBACK_URL=http://localhost:8080/api/v1/orders/from-live-auction
# Docker: LIVE_ORDER_CALLBACK_URL=http://api-gateway:8080/api/v1/orders/from-live-auction
LIVE_ORDER_CALLBACK_URL=

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000 # 30 seconds
METRICS_ENABLED=true
METRICS_PORT=9090

# Email Configuration (if needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mnbara.com

# File Upload Configuration
UPLOAD_MAX_SIZE=104857600 # 100MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/quicktime

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# SSL Configuration (for production)
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=
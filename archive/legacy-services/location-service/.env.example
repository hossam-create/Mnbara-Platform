PORT=3021
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mnbara_location?schema=public"

# Service Info
SERVICE_NAME=location-service
SERVICE_VERSION=1.0.0

# Geospatial Settings
DEFAULT_SEARCH_RADIUS_KM=10
MAX_SEARCH_RADIUS_KM=100
MAX_NEARBY_RESULTS=50

# Route Matching
MAX_DETOUR_KM=10
DEFAULT_ROUTE_CAPACITY=5

# Geofencing
GEOFENCE_CHECK_INTERVAL_MS=5000

# Logging
LOG_LEVEL=info

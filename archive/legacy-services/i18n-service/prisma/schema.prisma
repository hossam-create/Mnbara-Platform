generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Language {
  id          String   @id @default(cuid())
  code        String   @unique // en, ar, fr, etc.
  name        String   // English, Arabic, French
  nativeName  String   // English, العربية, Français
  direction   String   @default("ltr") // ltr or rtl
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations Translation[]

  @@index([code])
  @@index([enabled])
}

model TranslationKey {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "common.welcome"
  namespace   String   // common, auth, product, etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations Translation[]

  @@index([namespace])
  @@index([key])
}

model Translation {
  id        String   @id @default(cuid())
  keyId     String
  langCode  String
  value     String   @db.Text
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key      TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  language Language       @relation(fields: [langCode], references: [code], onDelete: Cascade)

  @@unique([keyId, langCode])
  @@index([keyId])
  @@index([langCode])
}

{
  "metadata": {
    "id": "stripe-payment",
    "name": "Stripe Payment Integration",
    "version": "1.0.0",
    "description": "Stripe payment processing integration for the platform",
    "author": "mnbara team",
    "main": "index.js",
    "dependencies": {
      "stripe": "^12.0.0"
    },
    "permissions": [
      "payment.process",
      "payment.refund",
      "customer.read",
      "transaction.write"
    ],
    "hooks": [
      "payment:beforeProcess",
      "payment:afterProcess",
      "payment:beforeRefund",
      "payment:afterRefund"
    ],
    "config": {
      "apiKey": "",
      "webhookSecret": "",
      "currency": "usd",
      "testMode": true
    }
  },
  "entry": "index.js",
  "enabled": true,
  "installedAt": "2024-01-01T00:00:00.000Z",
  "config": {}
}
  "keywords": [
    "mnbara",
    "plugin",
    "live-streaming",
    "ebay-live"
  ],
  "author": "{{author}}",
  "license": "MIT",
  "dependencies": {
    "@mnbara/plugin-core": "^1.0.0",
    "@mnbara/live-streaming": "^1.0.0",
    "socket.io-client": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/jest": "^29.2.5",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "eslint": "^8.32.0",
    "jest": "^29.3.1",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4",
    "rimraf": "^4.1.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "paths": {
      "@mnbara/plugin-core": ["../core/integration/index.ts"],
      "@mnbara/plugin-manager": ["../core/integration/index.ts"],
      "@mnbara/hook-system": ["../core/hook-system/index.ts"],
      "@mnbara/plugin-registry": ["../core/plugin-registry/index.ts"],
      "@mnbara/plugin-marketplace": ["../marketplace/index.ts"],
      "@mnbara/plugin-testing": ["../testing/index.ts"]
    }
  },
  "include": [
    "index.ts",
    "*.ts",
    "cli/**/*",
    "templates/**/*",
    "examples/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "templates/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
{
  "name": "@mnbara/plugin-test-plugin",
  "description": "A test plugin",
  "author": "Test Author",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mnbara",
    "plugin",
    "test-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "@mnbara/plugin-sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "nodemon": "^3.0.0"
  },
  "peerDependencies": {
    "@mnbara/plugin-system": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

{
  "name": "@mnbara/plugin-sdk",
  "version": "1.0.0",
  "description": "Official SDK for building MNBara plugins with TypeScript support, comprehensive tooling, and best practices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mnbara-plugin-template": "dist/cli.js",
    "mnbara-plugin": "dist/plugin-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "prepublishOnly": "npm run build && npm test",
    "postbuild": "chmod +x dist/cli.js dist/plugin-cli.js"
  },
  "keywords": [
    "mnbara",
    "plugin",
    "sdk",
    "wallet",
    "blockchain",
    "typescript",
    "plugin-development",
    "template-generator"
  ],
  "author": "MNBara Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnbara/plugin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mnbara/plugin-sdk/issues"
  },
  "homepage": "https://github.com/mnbara/plugin-sdk#readme",
  "dependencies": {
    "zod": "^3.22.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "@types/inquirer": "^8.2.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@mnbara/plugin-system": "^1.0.0"
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}

# ============================================================
# Plugin System Environment Configuration - Phase 3
# ============================================================

# Application Configuration
NODE_ENV=production
PORT=3015
PLATFORM_VERSION=1.0.0
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://plugin_system_user:secure_password_123@localhost:5433/plugin_system_db
DB_PASSWORD=secure_password_123

# Redis Configuration
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# Plugin Configuration
PLUGINS_DIR=./plugins
PLUGIN_MAX_SIZE=10485760 # 10MB in bytes
PLUGIN_TIMEOUT_MS=30000 # 30 seconds
PLUGIN_MEMORY_LIMIT_MB=512
PLUGIN_CPU_LIMIT_PERCENT=50

# Security Configuration
BCRYPT_ROUNDS=12
API_KEY_LENGTH=64
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
UPLOAD_MAX_SIZE=52428800 # 50MB
UPLOAD_ALLOWED_TYPES=.js,.ts,.json,.md,.txt,.png,.jpg,.jpeg,.gif,.svg
UPLOAD_TEMP_DIR=./temp
UPLOAD_STORAGE_DIR=./uploads

# Sandbox Configuration
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_MS=10000 # 10 seconds
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_LIMIT_PERCENT=25
SANDBOX_NETWORK_ENABLED=false

# Event Bus Configuration
EVENT_BUS_ENABLED=true
EVENT_BUS_REDIS_KEY_PREFIX=plugin_events
EVENT_BUS_MAX_EVENTS_PER_SECOND=1000
EVENT_BUS_RETENTION_HOURS=24

# Marketplace Configuration
MARKETPLACE_COMMISSION_PERCENT=15
MARKETPLACE_MINIMUM_PAYOUT_AMOUNT=100
MARKETPLACE_PAYOUT_CURRENCY=USD
MARKETPLACE_PAYOUT_SCHEDULE=monthly

# Documentation Configuration
DOCS_MAX_SIZE=1048576 # 1MB
DOCS_ALLOWED_TYPES=.md,.txt,.json
DOCS_TEMPLATES_DIR=./docs/templates
DOCS_CACHE_TTL_SECONDS=3600 # 1 hour

# Support Configuration
SUPPORT_TICKET_MAX_AGE_DAYS=90
SUPPORT_RESPONSE_TIME_SLA_HOURS=24
SUPPORT_ESCALATION_TIME_HOURS=72

# Monitoring Configuration
HEALTH_CHECK_INTERVAL_MS=30000 # 30 seconds
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics

# Logging Configuration
LOG_FILE_MAX_SIZE=10485760 # 10MB
LOG_FILE_MAX_FILES=10
LOG_FILE_COMPRESS=true
LOG_FILE_FORMAT=json

# Email Configuration (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mnbara.com
EMAIL_FROM_NAME=MNBara Plugins

# External Services
GITHUB_API_URL=https://api.github.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CDN Configuration
CDN_ENABLED=false
CDN_BASE_URL=
CDN_API_KEY=
CDN_SECRET_KEY=

# Development Configuration (override in development)
DEV_MODE=false
DEV_HOT_RELOAD=true
DEV_DEBUG_PLUGINS=true
DEV_SKIP_VALIDATION=false

# Performance Configuration
MAX_CONCURRENT_PLUGINS=50
PLUGIN_INITIALIZATION_TIMEOUT_MS=30000
PLUGIN_SHUTDOWN_TIMEOUT_MS=10000

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=100
CACHE_CLEANUP_INTERVAL_MS=300000 # 5 minutes

# Rate Limiting Configuration (per endpoint)
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_PLUGIN_INSTALL=10/hour
RATE_LIMIT_PLUGIN_SUBMIT=5/day
RATE_LIMIT_DOCS_UPDATE=50/hour
RATE_LIMIT_SUPPORT_TICKETS=10/day

# Security Headers
SECURITY_HEADERS_ENABLED=true
SECURITY_CORS_ORIGIN=*
SECURITY_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
SECURITY_CORS_HEADERS=Content-Type,Authorization,X-Requested-With
SECURITY_FRAME_OPTIONS=DENY
SECURITY_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_XSS_PROTECTION=1; mode=block

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups
BACKUP_COMPRESSION=true

# SSL/TLS Configuration (for production)
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=
SSL_CIPHERS=HIGH:!aNULL:!MD5
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
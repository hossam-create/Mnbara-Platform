generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderId     String   @unique
  rating      Int      // 1-5
  title       String?
  comment     String
  images      String[] // URLs
  verified    Boolean  @default(false)
  helpful     Int      @default(0)
  reported    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes       ReviewVote[]

  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  helpful   Boolean  // true = helpful, false = not helpful
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model SellerRating {
  id          String   @id @default(cuid())
  sellerId    String
  buyerId     String
  orderId     String   @unique
  rating      Int      // 1-5
  categories  Json     // {communication: 5, shipping: 4, quality: 5}
  comment     String?
  createdAt   DateTime @default(now())

  @@index([sellerId])
  @@index([buyerId])
}

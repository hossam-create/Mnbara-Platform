# P2P Exchange Service - Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3005

# Database
DATABASE_URL=postgresql://mnbarh:mnbarh_dev_password@localhost:5432/p2p_exchange_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-256-bit-key-for-security

# FX Provider (OpenExchangeRates)
OPENEXCHANGERATES_API_KEY=your-openexchangerates-api-key
OPENEXCHANGERATES_BASE_URL=https://openexchangerates.org/api

# External Escrow Provider (Tatum.io)
TATUM_API_KEY=your-tatum-api-key
TATUM_BASE_URL=https://api.tatum.io/v3

# Payment Service Providers (PSP)
# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Wise (TransferWise)
WISE_API_KEY=your-wise-api-key
WISE_BASE_URL=https://api.sandbox.transferwise.tech

# File Storage
STORAGE_TYPE=local # or 's3'
UPLOAD_PATH=./uploads

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=mnbarh-p2p-proofs
AWS_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Feature Flags
ENABLE_AUTOMATIC_MATCHING=true
ENABLE_EXTERNAL_ESCROW=true
ENABLE_COMMUNICATION=true
MATCHING_INTERVAL_SECONDS=30

# Security Settings
MAX_TRANSACTION_AMOUNT=10000
MIN_TRANSACTION_AMOUNT=10
SECURITY_DEPOSIT_PERCENTAGE=5
MAX_PROOF_FILE_SIZE=10485760 # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Trust Level Settings
TRUST_LEVEL_BRONZE_MAX=1000
TRUST_LEVEL_SILVER_MAX=5000
TRUST_LEVEL_GOLD_MAX=10000

# Timeout Settings
PAYMENT_TIMEOUT_MINUTES=30
PROOF_UPLOAD_TIMEOUT_MINUTES=60
RECEIPT_CONFIRMATION_TIMEOUT_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

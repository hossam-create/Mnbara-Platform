# P2P Exchange Service - Staging Environment Variables

# Server Configuration
NODE_ENV=staging
PORT=3005

# Database
DATABASE_URL=postgresql://mnbarh_staging:staging_password@staging-db:5432/p2p_exchange_staging

# Redis
REDIS_URL=redis://staging-redis:6379

# JWT Authentication
JWT_SECRET=staging-jwt-secret-key-change-for-production-256-bit

# FX Provider (OpenExchangeRates)
OPENEXCHANGERATES_API_KEY=your-staging-openexchangerates-api-key
OPENEXCHANGERATES_BASE_URL=https://openexchangerates.org/api

# External Escrow Provider (Tatum.io)
TATUM_API_KEY=your-staging-tatum-api-key
TATUM_BASE_URL=https://api.tatum.io/v3

# Payment Service Providers (PSP) - Test/Sandbox Mode
# Stripe
STRIPE_SECRET_KEY=sk_test_staging_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_staging_webhook_secret

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=staging-paypal-client-id
PAYPAL_CLIENT_SECRET=staging-paypal-client-secret

# Wise (TransferWise)
WISE_API_KEY=staging-wise-api-key
WISE_BASE_URL=https://api.sandbox.transferwise.tech

# File Storage
STORAGE_TYPE=s3
UPLOAD_PATH=./uploads

# AWS S3
AWS_ACCESS_KEY_ID=staging-aws-access-key-id
AWS_SECRET_ACCESS_KEY=staging-aws-secret-access-key
AWS_S3_BUCKET=mnbarh-p2p-proofs-staging
AWS_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=https://staging.mnbarh.com,http://localhost:3000

# Feature Flags
ENABLE_AUTOMATIC_MATCHING=true
ENABLE_EXTERNAL_ESCROW=true
ENABLE_COMMUNICATION=true
MATCHING_INTERVAL_SECONDS=30

# Security Settings (Staging - Lower Limits)
MAX_TRANSACTION_AMOUNT=1000
MIN_TRANSACTION_AMOUNT=10
SECURITY_DEPOSIT_PERCENTAGE=5
MAX_PROOF_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Trust Level Settings (Staging - Lower Limits)
TRUST_LEVEL_BRONZE_MAX=100
TRUST_LEVEL_SILVER_MAX=500
TRUST_LEVEL_GOLD_MAX=1000

# Timeout Settings
PAYMENT_TIMEOUT_MINUTES=30
PROOF_UPLOAD_TIMEOUT_MINUTES=60
RECEIPT_CONFIRMATION_TIMEOUT_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Error Tracking (Sentry)
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/project-id

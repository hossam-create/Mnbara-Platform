# P2P Exchange Service - Production Environment Variables

# Server Configuration
NODE_ENV=production
PORT=3005

# Database
DATABASE_URL=postgresql://mnbarh_prod:production_password@prod-db:5432/p2p_exchange_production

# Redis
REDIS_URL=redis://prod-redis:6379

# JWT Authentication
JWT_SECRET=production-jwt-secret-key-CHANGE-THIS-256-bit-minimum-security

# FX Provider (OpenExchangeRates)
OPENEXCHANGERATES_API_KEY=your-production-openexchangerates-api-key
OPENEXCHANGERATES_BASE_URL=https://openexchangerates.org/api

# External Escrow Provider (Tatum.io)
TATUM_API_KEY=your-production-tatum-api-key
TATUM_BASE_URL=https://api.tatum.io/v3

# Payment Service Providers (PSP) - Production Mode
# Stripe
STRIPE_SECRET_KEY=sk_live_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_production_webhook_secret

# PayPal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=production-paypal-client-id
PAYPAL_CLIENT_SECRET=production-paypal-client-secret

# Wise (TransferWise)
WISE_API_KEY=production-wise-api-key
WISE_BASE_URL=https://api.transferwise.com

# File Storage
STORAGE_TYPE=s3
UPLOAD_PATH=./uploads

# AWS S3
AWS_ACCESS_KEY_ID=production-aws-access-key-id
AWS_SECRET_ACCESS_KEY=production-aws-secret-access-key
AWS_S3_BUCKET=mnbarh-p2p-proofs-production
AWS_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=https://mnbarh.com,https://www.mnbarh.com,https://app.mnbarh.com

# Feature Flags
ENABLE_AUTOMATIC_MATCHING=true
ENABLE_EXTERNAL_ESCROW=true
ENABLE_COMMUNICATION=true
MATCHING_INTERVAL_SECONDS=30

# Security Settings (Production - Full Limits)
MAX_TRANSACTION_AMOUNT=10000
MIN_TRANSACTION_AMOUNT=10
SECURITY_DEPOSIT_PERCENTAGE=5
MAX_PROOF_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Trust Level Settings (Production - Full Limits)
TRUST_LEVEL_BRONZE_MAX=1000
TRUST_LEVEL_SILVER_MAX=5000
TRUST_LEVEL_GOLD_MAX=10000

# Timeout Settings
PAYMENT_TIMEOUT_MINUTES=30
PROOF_UPLOAD_TIMEOUT_MINUTES=60
RECEIPT_CONFIRMATION_TIMEOUT_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Error Tracking (Sentry)
SENTRY_DSN=https://production-sentry-dsn@sentry.io/project-id

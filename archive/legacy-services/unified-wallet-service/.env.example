# ============================================================
# Unified Wallet Service Environment Configuration
# ============================================================

# Application Configuration
NODE_ENV=production
PORT=3016
LOG_LEVEL=info
SERVICE_NAME=unified-wallet-service

# Database Configuration
DATABASE_URL=postgresql://unified_wallet_user:secure_password_123@localhost:5434/unified_wallet_db
DB_PASSWORD=secure_password_123
DB_POOL_SIZE=20
DB_TIMEOUT_MS=30000

# Redis Configuration
REDIS_URL=redis://localhost:6381
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT_MS=5000

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# Supported Currencies (ISO 4217)
SUPPORTED_CURRENCIES=USD,EUR,GBP,SAR,AED,EGP,JPY,CNY,INR,TRY
BASE_CURRENCY=USD

# Fee Structure
PLATFORM_FEE_PERCENT=2.5
PROCESSING_FEE_PERCENT=1.5
CONVERSION_FEE_PERCENT=1.0
MINIMUM_FEE_USD=0.50

# Transaction Limits (USD equivalent)
DEFAULT_DAILY_LIMIT=10000
DEFAULT_MONTHLY_LIMIT=100000
DEFAULT_YEARLY_LIMIT=1000000
DEFAULT_PER_TRANSACTION_LIMIT=5000

# KYC/AML Configuration
KYC_VERIFICATION_REQUIRED=true
AML_COMPLIANCE_ENABLED=true
SANCTIONS_CHECK_ENABLED=true
RISK_ASSESSMENT_ENABLED=true

# Exchange Rate Configuration
EXCHANGE_RATE_SOURCE=mock # Options: mock, xe, fixer, ecb
EXCHANGE_RATE_UPDATE_INTERVAL_MS=300000 # 5 minutes
EXCHANGE_RATE_CACHE_TTL_MS=3600000 # 1 hour
EXCHANGE_RATE_SPREAD_PERCENT=0.5

# Security Configuration
BCRYPT_ROUNDS=12
API_KEY_LENGTH=64
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Escrow Configuration
ESCROW_HOLD_DURATION_MS=2592000000 # 30 days
ESCROW_AUTO_RELEASE_ENABLED=true
ESCROW_DISPUTE_TIMEOUT_MS=604800000 # 7 days

# Payout Configuration
PAYOUT_PROCESSING_ENABLED=true
PAYOUT_BATCH_SIZE=100
PAYOUT_RETRY_ATTEMPTS=3
PAYOUT_RETRY_DELAY_MS=60000 # 1 minute

# Banking Integration
BANK_API_ENDPOINT=
BANK_API_KEY=
BANK_API_SECRET=
BANK_WEBHOOK_SECRET=
BANK_TIMEOUT_MS=30000

# Payment Gateway Integration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=

# Compliance Integration
COMPLIANCE_API_ENDPOINT=
COMPLIANCE_API_KEY=
COMPLIANCE_WEBHOOK_SECRET=
SANCTIONS_API_ENDPOINT=
SANCTIONS_API_KEY=

# Notification Configuration
NOTIFICATION_SERVICE_URL=
NOTIFICATION_API_KEY=
EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=true

# Audit and Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years
TRANSACTION_LOG_RETENTION_DAYS=2555 # 7 years
COMPLIANCE_LOG_RETENTION_DAYS=2555 # 7 years

# Performance Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600 # 1 hour
CACHE_MAX_SIZE_MB=100
CONNECTION_POOL_SIZE=20
QUERY_TIMEOUT_MS=30000

# Background Jobs
BACKGROUND_JOBS_ENABLED=true
JOB_QUEUE_CONCURRENCY=10
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_MS=60000 # 1 minute

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics
HEALTH_CHECK_INTERVAL_MS=30000 # 30 seconds
ALERTING_ENABLED=true

# SSL/TLS Configuration
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
SSL_CIPHERS=HIGH:!aNULL:!MD5

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true

# Rate Limiting (per endpoint)
RATE_LIMIT_WALLET_CREATE=10/hour
RATE_LIMIT_WALLET_OPERATIONS=100/minute
RATE_LIMIT_TRANSFER=50/minute
RATE_LIMIT_SETTLEMENT=20/minute
RATE_LIMIT_ESCROW=30/minute
RATE_LIMIT_CONVERSION=25/minute
RATE_LIMIT_PAYOUT=10/hour

# Feature Flags
MULTI_CURRENCY_ENABLED=true
AUTO_CONVERSION_ENABLED=true
FOREX_HEDGING_ENABLED=false
ESCROW_ENABLED=true
PAYOUTS_ENABLED=true
COMPLIANCE_CHECKS_ENABLED=true
REAL_TIME_SETTLEMENT_ENABLED=true

# Development Configuration
DEV_MODE=false
DEV_MOCK_SERVICES=false
DEV_SKIP_COMPLIANCE=false
DEV_SKIP_NOTIFICATIONS=false

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups
BACKUP_COMPRESSION=true

# Disaster Recovery
DR_ENABLED=false
DR_REPLICATION_ENABLED=false
DR_BACKUP_INTERVAL_HOURS=6
DR_RECOVERY_TIME_OBJECTIVE_HOURS=4
DR_RECOVERY_POINT_OBJECTIVE_HOURS=1
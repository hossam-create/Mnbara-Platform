# Production Environment Configuration
# Decision Authority Service

# Feature Flags
DECISION_AUTHORITY_MODE=INTERNAL
DECISION_TIMEOUT_MS=30000
DECISION_POLL_INTERVAL_MS=5000

# Custodii Integration (production)
CUSTODII_API_URL=https://api.custodii.com/v1
CUSTODII_API_KEY=sk_live_xxxxxxxxxxxxx
CUSTODII_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Database
DATABASE_URL=postgresql://prod_user:prod_password@postgres-prod:5432/decision_authority_prod

# Monitoring & Logging
LOG_LEVEL=info
METRICS_ENABLED=true
SENTRY_DSN=https://prod_key@sentry.io/prod_project_id

# Node Environment
NODE_ENV=production
PORT=3010


# Staging Environment Configuration
# Decision Authority Service

# Feature Flags
DECISION_AUTHORITY_MODE=INTERNAL
DECISION_TIMEOUT_MS=30000
DECISION_POLL_INTERVAL_MS=5000

# Custodii Integration (staging - mock values)
CUSTODII_API_URL=https://staging-api.custodii.com/v1
CUSTODII_API_KEY=sk_staging_test_key_xxxxxxxxxxxxx
CUSTODII_WEBHOOK_SECRET=whsec_staging_test_secret_xxxxxxxxxxxxx

# Database
DATABASE_URL=postgresql://staging_user:staging_password@postgres-staging:5432/decision_authority_staging

# Monitoring & Logging
LOG_LEVEL=debug
METRICS_ENABLED=true
SENTRY_DSN=https://staging_key@sentry.io/staging_project_id

# Node Environment
NODE_ENV=staging
PORT=3010

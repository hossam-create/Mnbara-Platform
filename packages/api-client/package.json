{
  "name": "@mnbara/api-client",
  "version": "1.0.0",
  "description": "Shared API client for Mnbara Platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mnbara",
    "api",
    "client",
    "http"
  ],
  "author": "Mnbara Team",
  "license": "MIT",
  "peerDependencies": {
    "@mnbara/shared-types": "^1.0.0"
  },
  "dependencies": {
    "ky": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

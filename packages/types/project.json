{
  "name": "types",
  "$schemRoot": "packages/types/src",
  "projectType": "library",
  "tags": ["type:types", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/types",
        "main": "packages/types/src/index.ts",
        "tsConfig": "packages/types/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/packages/types"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/packages/types"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/types/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}

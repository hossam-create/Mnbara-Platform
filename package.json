{
  "name": "mnbara-platform",
  "version": "1.0.0",
  "description": "Mnbara E-commerce Platform - Unified Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/core/*",
    "services/marketplace/*",
    "services/crowdshipping/*",
    "services/financial/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "setup:dev": "bash scripts/dev-setup.sh",
    "setup:dev:win": "scripts\\dev-setup.bat",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test --all --run",
    "test:affected": "nx affected --target=test --run",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:integration": "npx vitest run test/integration/mvp-integration.test.ts",
    "test:all": "npx vitest run",
    "lint": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev": "nx run-many --target=serve --all --parallel",
    "dev:auth-service": "nx serve services-core-auth-service",
    "dev:user-service": "nx serve services-core-user-service",
    "dev:notification-service": "nx serve services-core-notification-service",
    "dev:product-service": "nx serve services-marketplace-product-service",
    "dev:order-service": "nx serve services-marketplace-order-service",
    "dev:cart-service": "nx serve services-marketplace-cart-service",
    "dev:payment-service": "nx serve services-financial-payment-service",
    "dev:wallet-service": "nx serve services-financial-wallet-service",
    "dev:trips-service": "nx serve services-crowdshipping-trips-service",
    "dev:matching-service": "nx serve services-crowdshipping-matching-service",
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "nx serve apps-mobile",
    "dev:frontend": "cd frontend/web-app && npm run dev",
    "dev:listing": "cd backend/services/listing-service-node && npm run dev",
    "dev:cart": "cd backend/services/cart-service && npm run dev",
    "dev:payment": "cd services/financial/payment-service && npm run dev",
    "graph": "nx graph",
    "graph:affected": "nx graph --affected",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup:db": "bash scripts/setup-databases.sh",
    "setup:db:win": "scripts\\setup-databases.bat",
    "start": "cd frontend/web-app && npm install && npm run dev",
    "start:mvp": "bash scripts/start-mvp.sh",
    "start:mvp:win": "scripts\\start-mvp.bat",
    "build:frontend": "cd frontend/web-app && npm install && npm run build",
    "preview:frontend": "cd frontend/web-app && npm run preview",
    "verify": "bash scripts/verify-services.sh",
    "verify:win": "scripts\\verify-services.bat"
  },
  "dependencies": {
    "@nx/devkit": "^20.3.0",
    "nx": "^20.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nx/eslint": "^20.3.0",
    "@nx/eslint-plugin": "^20.3.0",
    "@nx/jest": "^20.3.0",
    "@nx/js": "^20.3.0",
    "@nx/node": "^20.3.0",
    "@nx/react": "^20.3.0",
    "@nx/vite": "^20.3.0",
    "@nx/workspace": "^20.3.0",
    "@prisma/client": "^5.22.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.0.18",
    "axios": "^1.6.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^3.15.0",
    "happy-dom": "^20.8.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.0.18"
  }
}

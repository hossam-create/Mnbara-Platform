# Mnbara Platform Database Migration Environment Variables
# Copy this file to .env and configure your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=mnbara_dev
DB_PASSWORD=your_password_here
DB_NAME=mnbara_development

# Migration Settings
MIGRATIONS_TABLE=schema_migrations
LOCK_TABLE=schema_migrations_lock
SEEDS_TABLE=seed_logs

# Environment
NODE_ENV=development

# Application Settings
APP_PORT=3000
LOG_LEVEL=info

# Optional: Database URL (alternative to individual params)
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional: Redis for caching (if needed)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Optional: JWT Secret (for token generation)
# JWT_SECRET=your-super-secret-key

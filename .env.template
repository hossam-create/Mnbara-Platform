# Mnbara Platform - Unified Environment Configuration
# This file contains all environment variables needed for the platform
# Copy this to .env and fill in your actual values

# ==============================================
# INFRASTRUCTURE SERVICES
# ==============================================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mnbara
POSTGRES_MULTIPLE_DATABASES=mnbara,mnbara_auth,mnbara_payments,mnbara_auctions,mnbara_country_layer,mnbara_subscriptions

# Redis Cache & Session Storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Message Queue
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch Search Engine
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# ==============================================
# CORE PLATFORM SERVICES
# ==============================================

# API Gateway (Port 3000)
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=localhost
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication Service (Port 3001)
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST=localhost
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-2024
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# User Service (Port 3002)
USER_SERVICE_PORT=3002
USER_SERVICE_HOST=localhost

# Product/Listing Service (Port 3003)
PRODUCT_SERVICE_PORT=3003
PRODUCT_SERVICE_HOST=localhost
LISTING_SERVICE_PORT=3003
LISTING_SERVICE_HOST=localhost

# Order Service (Port 3004)
ORDER_SERVICE_PORT=3004
ORDER_SERVICE_HOST=localhost

# Payment Service (Port 3005)
PAYMENT_SERVICE_PORT=3005
PAYMENT_SERVICE_HOST=localhost

# ==============================================
# PAYMENT PROVIDERS
# ==============================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_ENVIRONMENT=sandbox

# Paymob (Middle East)
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID=your_integration_id_here
PAYMOB_IFRAME_ID=your_iframe_id_here

# ==============================================
# AI & EXTERNAL SERVICES
# ==============================================

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION_ID=your_org_id_here

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Pinecone (Vector Database)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_environment_here
PINECONE_INDEX_NAME=mnbara-index

# ==============================================
# COUNTRY LAYER SERVICE
# ==============================================

COUNTRY_LAYER_SERVICE_PORT=3015
COUNTRY_LAYER_SERVICE_HOST=localhost
COUNTRY_LAYER_SERVICE_URL=http://localhost:3015/api/v1
COUNTRY_LAYER_SERVICE_TOKEN=your_country_layer_service_token

# ==============================================
# SUBSCRIPTION SERVICE
# ==============================================

SUBSCRIPTION_SERVICE_PORT=3025
SUBSCRIPTION_SERVICE_HOST=localhost
SUBSCRIPTION_SERVICE_URL=http://localhost:3025/api/v1

# Default subscription plans
DEFAULT_FREE_FEATURES=create-product,browse-products,basic-search
DEFAULT_BASIC_FEATURES=create-product,browse-products,basic-search,send-messages
DEFAULT_PREMIUM_FEATURES=create-product,browse-products,basic-search,send-messages,request-item-from-traveler,priority-support,advanced-analytics

# ==============================================
# AUCTION SERVICE
# ==============================================

AUCTION_SERVICE_PORT=3006
AUCTION_SERVICE_HOST=localhost
AUCTION_WEBSOCKET_PORT=3007

# ==============================================
# WALLET & CRYPTO SERVICES
# ==============================================

# Wallet Service
WALLET_SERVICE_PORT=3008
WALLET_SERVICE_HOST=localhost

# Crypto Service
CRYPTO_SERVICE_PORT=3009
CRYPTO_SERVICE_HOST=localhost

# Blockchain (if enabled)
BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/your_project_id
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
BLOCKCHAIN_NETWORK=mainnet

# ==============================================
# NOTIFICATION SERVICES
# ==============================================

# Email/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@mnbara.com

# SMS/Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=your_sender_id_here

# ==============================================
# SECURITY & MONITORING
# ==============================================

# Security
ENCRYPTION_KEY=your_32_character_encryption_key_here
HASH_SALT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_AGENT_PORT=6831
JAEGER_COLLECTOR_PORT=14268

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs

# ==============================================
# EXTERNAL INTEGRATIONS
# ==============================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Apple OAuth
APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY_PATH=./keys/apple_private_key.p8

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================

# Development Mode
NODE_ENV=development
DEBUG=true
API_DEBUG=true

# Hot Reload
HOT_RELOAD=true
WATCH_MODE=true

# Mock Services (for development)
MOCK_PAYMENT_GATEWAY=true
MOCK_SMS_SERVICE=true
MOCK_EMAIL_SERVICE=true
MOCK_BLOCKCHAIN=true

# ==============================================
# PRODUCTION SETTINGS (Override in production.env)
# ==============================================

# Production overrides would go in production.env:
# NODE_ENV=production
# DEBUG=false
# MOCK_PAYMENT_GATEWAY=false
# MOCK_SMS_SERVICE=false
# MOCK_EMAIL_SERVICE=false
# MOCK_BLOCKCHAIN=false
# LOG_LEVEL=warn
# RATE_LIMIT_MAX_REQUESTS=50

# ==============================================
# SERVICE-SPECIFIC SETTINGS
# ==============================================

# Matching Service
MATCHING_SERVICE_PORT=3010
MATCHING_SERVICE_HOST=localhost
MATCHING_ALGORITHM_VERSION=v2

# Trips Service
TRIPS_SERVICE_PORT=3011
TRIPS_SERVICE_HOST=localhost

# Notification Service
NOTIFICATION_SERVICE_PORT=3012
NOTIFICATION_SERVICE_HOST=localhost

# Analytics Service
ANALYTICS_SERVICE_PORT=3013
ANALYTICS_SERVICE_HOST=localhost

# KYC Service
KYC_SERVICE_PORT=3014
KYC_SERVICE_HOST=localhost

# ==============================================
# FEATURE FLAGS
# ==============================================

# Core Features
ENABLE_USER_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_PAYMENT_GATEWAYS=true
ENABLE_CRYPTO_PAYMENTS=true
ENABLE_AUCTION_SYSTEM=true
ENABLE_REAL_TIME_BIDDING=true
ENABLE_COUNTRY_LAYER=true
ENABLE_SUBSCRIPTION_SYSTEM=true

# AI Features
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_AI_PRICING=true
ENABLE_AI_CHATBOT=true
ENABLE_AI_IMAGE_RECOGNITION=true
ENABLE_AI_VOICE_COMMERCE=true

# Advanced Features
ENABLE_BLOCKCHAIN_INTEGRATION=false
ENABLE_VR_SHOWROOM=false
ENABLE_AR_PREVIEW=false
ENABLE_VOICE_COMMERCE=false
ENABLE_SMART_DELIVERY=false

# Beta Features
ENABLE_BETA_FEATURES=false
ENABLE_EXPERIMENTAL_FEATURES=false

# ==============================================
# PERFORMANCE SETTINGS
# ==============================================

# Database
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# Cache
CACHE_TTL=3600
CACHE_PREFIX=mnbara
REDIS_CLUSTER_ENABLED=false

# API
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# ==============================================
# ERROR HANDLING
# ==============================================

ERROR_REPORTING_ENABLED=true
ERROR_REPORTING_DSN=your_error_reporting_dsn_here

# ==============================================
# BACKUP & RECOVERY
# ==============================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your_backup_bucket_here
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here
modules = ["nodejs-20", "python-3.12", "go-1.25", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Go Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Frontend"

[[workflows.workflow]]
name = "Go Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash geocore-next/backend/start.sh"
waitForPort = 9000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Web Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash geocore-next/frontend/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3001

[[ports]]
localPort = 6379
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 9000
externalPort = 9000

[[ports]]
localPort = 18115
externalPort = 5000

[[ports]]
localPort = 22333
externalPort = 4200

[[ports]]
localPort = 23744
externalPort = 3003

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd geocore-next/frontend && npm run build"]
publicDir = "frontend/web/dist"
run = ["bash", "-c", "cd geocore-next/frontend && npm start -- -p 5000"]

[userenv]

[userenv.shared]
REDIS_HOST = "localhost"
REDIS_PORT = "6379"
REDIS_PASSWORD = ""
FRONTEND_URL = "https://7ca9a76a-086e-4212-b96b-af311d65eac2-00-3akqqj9r08eoi-9ld65fsv.worf.replit.dev"
APP_BASE_URL = "https://7ca9a76a-086e-4212-b96b-af311d65eac2-00-3akqqj9r08eoi-9ld65fsv.worf.replit.dev"
BACKEND_PORT = "9000"

[userenv.development]
APP_ENV = "development"
GIN_MODE = "debug"

[userenv.production]
APP_ENV = "production"
GIN_MODE = "release"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

run = "cd frontend/web-app && npm install && npm run dev -- --host 0.0.0.0"
entrypoint = "frontend/web-app/src/main.tsx"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "cd frontend/web-app && npm run build && npm run preview -- --host 0.0.0.0"]

[[ports]]
localPort = 3000
externalPort = 80

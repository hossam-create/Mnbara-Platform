modules = ["nodejs-20", "python-3.12", "go-1.25"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GeoCore Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GeoCore Backend"

[[workflows.workflow]]
name = "GeoCore Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd geocore-next/frontend && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/web run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "GeoCore Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd geocore-next/backend && go run ./cmd/api/"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5174
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd geocore-next/frontend && npm run build"]
publicDir = "frontend/web/dist"
run = ["bash", "-c", "cd geocore-next/frontend && npm start -- -p 5000"]

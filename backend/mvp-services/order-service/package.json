{
  "name": "mvp-order-service",
  "version": "1.0.0",
  "description": "MVP Order Service - Simple eBay + Hitchhikers flow for Mnbara",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "migrate": "psql $DATABASE_URL -f migrations/001_create_orders.sql",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "order",
    "marketplace",
    "travel",
    "mvp",
    "ebay",
    "hitchhikers",
    "mnbara"
  ],
  "author": "Mnbara Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

# ============================================
# MVP Order Service Configuration
# ============================================
# Canonical Port: 3036

NODE_ENV=development
PORT=3036

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/order_db

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (must match auth-service)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# Internal Service URLs
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3011

# Logging
LOG_LEVEL=debug

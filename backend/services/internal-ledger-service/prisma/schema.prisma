// Internal Ledger System - Prisma Schema
// Simple ledger system for mnbarh platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PHASE 1.1: Internal Wallet System
// Simple wallet with available and locked balances
// ============================================================

// Wallet - User's wallet per currency
model Wallet {
  id                Int      @id @default(autoincrement())
  userId            Int
  currency          String   @default("USD") // USD, EUR, SAR, etc.
  
  // Balances
  availableBalance  Decimal  @default(0) @db.Decimal(19, 4)
  lockedBalance     Decimal  @default(0) @db.Decimal(19, 4) // For escrow holds
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  transactions      WalletTransaction[]
  buyerEscrows      EscrowHold[]        @relation("BuyerWallet")
  sellerEscrows     EscrowHold[]        @relation("SellerWallet")
  
  @@unique([userId, currency])
  @@index([userId])
  @@index([currency])
}

// Wallet Transaction - All wallet movements
model WalletTransaction {
  id              Int      @id @default(autoincrement())
  walletId        Int
  wallet          Wallet   @relation(fields: [walletId], references: [id])
  
  transactionType TransactionType
  amount          Decimal  @db.Decimal(19, 4)
  
  // Reference to external entity (Request, Payout, etc.)
  referenceType   String?  // "Request", "Payout", "Escrow", etc.
  referenceId     Int?
  
  status          TransactionStatus @default(PENDING)
  
  // Additional details
  metadata        Json?
  
  createdAt       DateTime @default(now())
  
  @@index([walletId])
  @@index([transactionType])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// Escrow Hold - Money locked for transactions
model EscrowHold {
  id                Int      @id @default(autoincrement())
  requestId         Int      @unique
  
  // Wallets involved
  buyerWalletId     Int
  buyerWallet       Wallet   @relation("BuyerWallet", fields: [buyerWalletId], references: [id])
  
  sellerWalletId    Int
  sellerWallet      Wallet   @relation("SellerWallet", fields: [sellerWalletId], references: [id])
  
  // Amounts
  amount            Decimal  @db.Decimal(19, 4)
  platformFee       Decimal  @db.Decimal(19, 4)
  
  status            EscrowStatus @default(HELD)
  
  // Timestamps
  heldAt            DateTime @default(now())
  releasedAt        DateTime?
  expiresAt         DateTime?
  
  // Release conditions
  releaseConditions Json?
  
  @@index([requestId])
  @@index([buyerWalletId])
  @@index([sellerWalletId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// ENUMS
// ============================================================

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  ESCROW_REFUND
  FEE_DEDUCTION
  PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

# ============================================
# Wallet Service Configuration
# ============================================
# Canonical Port: 3005

NODE_ENV=development
PORT=3005

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/wallet_db

# Redis Cache
REDIS_URL=redis://localhost:6379

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (must match auth-service)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# INTERNAL SERVICE URLS (canonical ports)
# ============================================
AUTH_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3011

# ============================================
# EXCHANGE RATE API
# ============================================
EXCHANGE_RATE_API_KEY=CHANGE_ME
EXCHANGE_RATE_API_URL=https://openexchangerates.org/api

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

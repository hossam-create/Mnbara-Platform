# ============================================
# Settlement Service Configuration
# ============================================
# Canonical Port: 3008

NODE_ENV=development
PORT=3008

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/settlement_db

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (must match auth-service)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# INTERNAL SERVICE URLS (canonical ports)
# ============================================
WALLET_SERVICE_URL=http://localhost:3005
ESCROW_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3011

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

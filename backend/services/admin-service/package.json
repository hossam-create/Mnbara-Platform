{
  "name": "mnbarh-admin-service",
  "version": "1.0.0",
  "description": "Mnbarh Platform Admin Service with Blockchain Integration",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch src --exec ts-node src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:run": "node scripts/run-migrations.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/cache-manager": "^2.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/elasticsearch": "^10.0.1",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@sentry/node": "^7.80.0",
    "@sentry/tracing": "^7.80.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^4.0.0",
    "cache-manager": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.0",
    "express-rate-limit": "^7.0.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.0.0",
    "mnbarh-platform": "file:../../..",
    "pg": "^8.11.0",
    "prom-client": "^15.0.0",
    "qrcode": "^1.5.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.6.0",
    "speakeasy": "^2.0.0",
    "ua-parser-js": "^1.0.39",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.4",
    "@types/express": "^4.17.20",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.8.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.2",
    "@types/speakeasy": "^2.0.7",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

# Security Service Environment Variables
# Variables d'environnement du service de sécurité

# Application
NODE_ENV=development
PORT=3010
API_VERSION=v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mnbara_security?schema=public

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Code Watermarking
WATERMARK_SECRET=your-watermark-secret-key
WATERMARK_ALGORITHM=SHA256

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_IV=your-16-char-iv

# Email (for security alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=security@example.com
SMTP_PASSWORD=your-smtp-password
ALERT_EMAIL=security-alerts@example.com

# External Security APIs
NVD_API_KEY=your-nvd-api-key
SNYK_TOKEN=your-snyk-token
GITHUB_TOKEN=your-github-token

# Customs Data API
CUSTOMS_API_KEY=your-customs-api-key
CUSTOMS_API_URL=https://api.customs-data.example.com

# Penetration Testing
PTES_API_URL=https://api.pentescore.example.com
PTES_API_KEY=your-pentescore-key

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Webhook for security alerts
SECURITY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

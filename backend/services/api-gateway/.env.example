# ============================================
# API Gateway Configuration
# ============================================
# Canonical Port: 3000

NODE_ENV=development
PORT=3000

# Redis Cache
REDIS_URL=redis://localhost:6379

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# JWT Secret (for token validation)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# SERVICE REGISTRY (canonical ports)
# ============================================
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
PRODUCT_SERVICE_URL=http://localhost:3004
WALLET_SERVICE_URL=http://localhost:3005
ORDERS_SERVICE_URL=http://localhost:3006
ESCROW_SERVICE_URL=http://localhost:3007
SETTLEMENT_SERVICE_URL=http://localhost:3008
TRIPS_SERVICE_URL=http://localhost:3009
MATCHING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
SUBSCRIPTION_SERVICE_URL=http://localhost:3012
CART_SERVICE_URL=http://localhost:3013
FEATURE_MANAGEMENT_SERVICE_URL=http://localhost:3014
ADMIN_SERVICE_URL=http://localhost:3015
COUNTRY_LAYER_SERVICE_URL=http://localhost:3016

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

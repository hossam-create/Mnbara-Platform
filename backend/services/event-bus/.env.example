# ============================================================
# Enhanced Event Bus Service Environment Configuration
# ============================================================

# Application Configuration
NODE_ENV=production
PORT=3017
SERVICE_NAME=enhanced-event-bus
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://event_bus_user:secure_password_123@localhost:5435/event_bus_db
DB_PASSWORD=secure_password_123
DB_POOL_SIZE=20
DB_TIMEOUT_MS=30000

# Redis Configuration
REDIS_URL=redis://localhost:6382
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT_MS=5000

# Event Processing Configuration
EVENT_BATCH_SIZE=100
EVENT_FLUSH_INTERVAL=5000
EVENT_MAX_RETRIES=3
EVENT_RETRY_DELAY=1000
EVENT_MAX_CONCURRENCY=10

# Event Validation Configuration
EVENT_VALIDATION_ENABLED=true
EVENT_VALIDATION_STRICT=false
EVENT_MAX_SIZE_BYTES=10485760 # 10MB
EVENT_TTL_SECONDS=2592000 # 30 days

# Event Routing Configuration
EVENT_ROUTING_ENABLED=true
EVENT_ROUTING_TIMEOUT_MS=30000
EVENT_DESTINATION_TIMEOUT_MS=10000

# Event Retention Configuration
EVENT_RETENTION_DAYS=365
EVENT_ARCHIVE_ENABLED=true
EVENT_ARCHIVE_AFTER_DAYS=90
EVENT_COMPRESSION_ENABLED=true
EVENT_COMPRESSION_AFTER_DAYS=30
EVENT_DELETE_AFTER_DAYS=1095 # 3 years

# Event Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_REAL_TIME_PROCESSING=true
ANALYTICS_BATCH_PROCESSING=true
ANALYTICS_AGGREGATION_INTERVAL=60000 # 1 minute
ANALYTICS_ALERT_CHECK_INTERVAL=300000 # 5 minutes

# Time-series Configuration
TIMESERIES_ENABLED=true
TIMESERIES_RETENTION_DAYS=365
TIMESERIES_COMPRESSION_ENABLED=true
TIMESERIES_AGGREGATION_LEVELS=1m,5m,15m,1h,6h,24h,7d,30d

# External Analytics Integration
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_TRACKING_ID=
MIXPANEL_ENABLED=false
MIXPANEL_TOKEN=
AMPLITUDE_ENABLED=false
AMPLITUDE_API_KEY=

# Event Storage Configuration
STORAGE_TYPE=redis # redis, postgres, hybrid
STORAGE_ARCHIVE_TYPE=local # local, s3, gcs
STORAGE_ARCHIVE_PATH=/app/archives
STORAGE_COMPRESSION_LEVEL=6
STORAGE_ENCRYPTION_ENABLED=false

# Event Indexing Configuration
INDEXING_ENABLED=true
INDEXING_REAL_TIME=true
INDEXING_BATCH_SIZE=1000
INDEXING_REFRESH_INTERVAL=30000 # 30 seconds
INDEXING_SHARD_COUNT=3
INDEXING_REPLICA_COUNT=2

# Event Alerting Configuration
ALERTING_ENABLED=true
ALERTING_CHANNELS=email,slack,webhook
ALERTING_COOLDOWN_MINUTES=60
ALERTING_SEVERITY_THRESHOLDS_LOW=100
ALERTING_SEVERITY_THRESHOLDS_MEDIUM=50
ALERTING_SEVERITY_THRESHOLDS_HIGH=20
ALERTING_SEVERITY_THRESHOLDS_CRITICAL=5

# Security Configuration
SECURITY_ENCRYPTION_ENABLED=false
SECURITY_SIGNING_ENABLED=false
SECURITY_RATE_LIMITING_ENABLED=true
SECURITY_RATE_LIMIT_MAX_EVENTS_PER_SECOND=1000
SECURITY_RATE_LIMIT_BURST_SIZE=2000
SECURITY_IP_WHITELIST=
SECURITY_IP_BLACKLIST=

# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_HEALTH_CHECK_INTERVAL=30000 # 30 seconds
MONITORING_METRICS_COLLECTION=true
MONITORING_METRICS_PORT=9090
MONITORING_METRICS_ENDPOINT=/metrics

# Performance Configuration
PERFORMANCE_BATCH_SIZE=100
PERFORMANCE_MAX_MEMORY_USAGE_MB=512
PERFORMANCE_MAX_CPU_USAGE_PERCENT=80
PERFORMANCE_GC_INTERVAL_MS=300000 # 5 minutes

# Connection Pool Configuration
CONNECTION_POOL_SIZE=20
CONNECTION_POOL_TIMEOUT_MS=30000
CONNECTION_POOL_IDLE_TIMEOUT_MS=600000 # 10 minutes
CONNECTION_POOL_MAX_LIFETIME_MS=1800000 # 30 minutes

# Background Job Configuration
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOBS_CONCURRENCY=5
BACKGROUND_JOBS_RETRY_ATTEMPTS=3
BACKGROUND_JOBS_RETRY_DELAY_MS=60000 # 1 minute
BACKGROUND_JOBS_MAX_EXECUTION_TIME_MS=300000 # 5 minutes

# Cleanup Configuration
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
CLEANUP_BATCH_SIZE=1000
CLEANUP_MAX_AGE_DAYS=1095 # 3 years
CLEANUP_ARCHIVE_BEFORE_DELETE=true

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups
BACKUP_COMPRESSION_ENABLED=true
BACKUP_ENCRYPTION_ENABLED=false

# Disaster Recovery Configuration
DR_ENABLED=false
DR_REPLICATION_ENABLED=false
DR_BACKUP_INTERVAL_HOURS=6
DR_RECOVERY_TIME_OBJECTIVE_HOURS=4
DR_RECOVERY_POINT_OBJECTIVE_HOURS=1

# Development Configuration
DEV_MODE=false
DEV_MOCK_SERVICES=false
DEV_SKIP_VALIDATION=false
DEV_DEBUG_EVENTS=false
DEV_VERBOSE_LOGGING=false

# Testing Configuration
TESTING_ENABLED=false
TESTING_MOCK_EXTERNAL_SERVICES=false
TESTING_GENERATE_SAMPLE_DATA=false
TESTING_CLEANUP_AFTER_TESTS=true

# SSL/TLS Configuration
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
SSL_CIPHERS=HIGH:!aNULL:!MD5

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With,X-Event-Type,X-Event-Category
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Webhook Configuration
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=5000
WEBHOOK_MAX_CONCURRENT_REQUESTS=50
WEBHOOK_USER_AGENT=MNBara-EventBus/1.0

# Email Configuration
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=noreply@mnbara.com
EMAIL_FROM_NAME=MNBara Event Bus

# Slack Configuration
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts
SLACK_USERNAME=EventBus
SLACK_ICON_EMOJI=:warning:

# PagerDuty Configuration
PAGERDUTY_ENABLED=false
PAGERDUTY_INTEGRATION_KEY=
PAGERDUTY_SERVICE_KEY=

# Logging Configuration
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/event-bus.log
LOG_FILE_MAX_SIZE=10485760 # 10MB
LOG_FILE_MAX_FILES=10
LOG_FILE_COMPRESS=true
LOG_FORMAT=json

# Metrics and Observability
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics
METRICS_INCLUDE_LABELS=true
METRICS_INCLUDE_TIMESTAMPS=true
TRACING_ENABLED=false
TRACING_SERVICE_NAME=event-bus
TRACING_JAEGER_ENDPOINT=
# P2P Exchange Service - Environment Variables

# Service Configuration
NODE_ENV=development
PORT=3005
SERVICE_NAME=p2p-exchange-service

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/p2p_exchange_db?schema=public

# Redis (for caching FX rates)
REDIS_URL=redis://localhost:6379
REDIS_TTL=60

# JWT Authentication
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# FX Provider (OpenExchangeRates)
OPENEXCHANGERATES_API_KEY=your-api-key-here
OPENEXCHANGERATES_BASE_URL=https://openexchangerates.org/api

# External Escrow Providers
# Tatum.io (Recommended Primary)
TATUM_API_KEY=your-tatum-api-key-here
TATUM_BASE_URL=https://api.tatum.io/v3

# PSP Providers
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# File Storage (S3 or Local)
STORAGE_TYPE=local
AWS_S3_BUCKET=mnbarh-p2p-proofs
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
LOCAL_STORAGE_PATH=./uploads

# Matching Engine
MATCHING_ENGINE_INTERVAL=30000
MATCHING_ENGINE_ENABLED=true

# Security Settings
SECURITY_DEPOSIT_MIN_USD=10
SECURITY_DEPOSIT_MIN_SAR=37.5
SECURITY_DEPOSIT_MIN_AED=36.7

# Trust Levels
TRUST_LEVEL_1_MAX=100
TRUST_LEVEL_2_MAX=500
TRUST_LEVEL_3_MAX=2000
TRUST_LEVEL_VIP_MAX=10000

# Transaction Classification
SMALL_TRANSACTION_MAX=300
MEDIUM_TRANSACTION_MAX=1000

# Timeouts (minutes)
PAYMENT_INITIATION_TIMEOUT=30
PROOF_UPLOAD_TIMEOUT=30
RECEIPT_CONFIRMATION_TIMEOUT=60
SETTLEMENT_TIMEOUT=1440

# Fee Structure
PLATFORM_FEE_SMALL=1.5
PLATFORM_FEE_MEDIUM=1.0
PLATFORM_FEE_LARGE=0.5
PROTECTION_FEE_MIN=2
PROTECTION_FEE_MAX=5
URGENT_MATCHING_FEE=0.5
DISPUTE_HANDLING_FEE=25

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000

# Internal Services
INTERNAL_LEDGER_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3001
TRUST_SAFETY_SERVICE_URL=http://localhost:3004

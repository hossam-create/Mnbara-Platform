# ============================================
# Payment Service Configuration
# ============================================
# Canonical Port: 3003

NODE_ENV=development
PORT=3003

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/payment_db

# Redis Cache
REDIS_URL=redis://localhost:6379

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# STRIPE CONFIGURATION
# ============================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_API_VERSION=2023-10-16
STRIPE_TEST_MODE=true

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=CHANGE_ME
FROM_EMAIL=noreply@mnbarh.com

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# PAYMENT SETTINGS
# ============================================
DEFAULT_CURRENCY=USD
PLATFORM_COMMISSION_RATE=0.05
MIN_PAYOUT_AMOUNT=1000
MAX_TRANSACTION_AMOUNT=100000000

# ============================================
# ESCROW SETTINGS
# ============================================
ESCROW_AUTO_RELEASE_DAYS=3
ESCROW_DISPUTE_PERIOD=7

# ============================================
# SECURITY
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_32

# ============================================
# INTERNAL SERVICE URLS (canonical ports)
# ============================================
WEBHOOK_BASE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3011
ORDER_SERVICE_URL=http://localhost:3006
USER_SERVICE_URL=http://localhost:3002
WALLET_SERVICE_URL=http://localhost:3005

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
ENABLE_TRANSACTION_LOGS=true

# ============================================
# TESTING
# ============================================
TEST_MODE=true

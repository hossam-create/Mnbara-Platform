# Country Layer Service Configuration
NODE_ENV=development
PORT=3015

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/mnbara_country_layer
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Security Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Cache Configuration
CACHE_TTL=3600
CACHE_PREFIX=country_layer

# External Services
PRODUCT_SERVICE_URL=http://localhost:3001
TRAVELER_SERVICE_URL=http://localhost:3002
MATCHING_ENGINE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# Feature Flags
ENABLE_COMPLIANCE_VALIDATION=true
ENABLE_COUNTRY_RESTRICTIONS=true
ENABLE_TRAVELER_ROUTING=true
ENABLE_CACHE=true

# Compliance Configuration
MAX_RISK_SCORE=100
DEFAULT_RISK_THRESHOLD=70
COMPLIANCE_LOG_RETENTION_DAYS=90
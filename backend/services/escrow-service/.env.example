# ============================================
# Escrow Service Configuration
# ============================================
# Canonical Port: 3007

NODE_ENV=development
PORT=3007

# Database
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/escrow_db

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (must match auth-service)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# INTERNAL SERVICE URLS (canonical ports)
# ============================================
AUTH_SERVICE_URL=http://localhost:3001
WALLET_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3011

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

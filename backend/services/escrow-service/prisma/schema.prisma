// Escrow Service Database Schema
// Inspired by Smart Contract: EscrowContract.sol

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Escrow Status Enum
enum EscrowStatus {
  CREATED
  SIGNED
  LOCKED
  RELEASED
  DISPUTED
  RESOLVED
  CANCELLED
}

// Dispute Status Enum
enum DisputeStatus {
  NONE
  INITIATED
  UNDER_REVIEW
  RESOLVED
}

// Escrow Transaction Model
// Based on: struct Transaction { buyer, seller, arbitrator, amount, status, ... }
model Escrow {
  id              String        @id @default(uuid())
  transactionId   String        @unique  // Like bytes32 in Solidity
  
  // Parties (addresses in Smart Contract)
  buyerId         String
  sellerId        String
  arbitratorId    String?
  
  // Amount
  amount          Decimal       @db.Decimal(18, 2)
  currency        String        @default("USD")
  
  // Status
  status          EscrowStatus  @default(CREATED)
  disputeStatus   DisputeStatus @default(NONE)
  
  // Signatures (mapping in Smart Contract)
  signatures      Json          @default("[]")  // Array of Signature objects
  
  // Dispute fields
  disputeReason   String?
  disputeDeadline DateTime?
  disputeReasonIPFS String?     // IPFS hash like in Smart Contract
  
  // Resolution
  resolution      String?       // 'BUYER' or 'SELLER'
  resolvedBy      String?
  resolvedAt      DateTime?
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lockedAt        DateTime?
  releasedAt      DateTime?
  
  // Indexes
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([transactionId])
  @@map("escrows")
}

// Escrow Event Log (like events in Smart Contract)
model EscrowEvent {
  id              String   @id @default(uuid())
  escrowId        String
  eventType       String   // TransactionCreated, TransactionLocked, etc.
  eventData       Json
  triggeredBy     String
  createdAt       DateTime @default(now())
  
  @@index([escrowId])
  @@index([eventType])
  @@map("escrow_events")
}

{
  "name": "@mnbara/craftercms-content-service",
  "version": "1.0.0",
  "description": "CrafterCMS Content Service for Mnbara Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "docker:build": "docker build -t mnbara-craftercms-content-service .",
    "docker:run": "docker run -p 3002:3002 mnbara-craftercms-content-service",

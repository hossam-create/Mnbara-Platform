{
  "name": "@mnbara/plugin-system",
  "version": "1.0.0",
  "description": "Plugin system for mnbara platform",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:core && npm run build:examples",
    "build:core": "tsc -p tsconfig.core.json",
    "build:examples": "tsc -p tsconfig.examples.json",
    "test": "jest",
    "dev": "ts-node-dev --respawn --transpile-only examples/basic-usage.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "fs-extra": "^11.1.1",
    "chalk": "^4.1.2",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/jest": "^29.5.3",
    "typescript": "^5.1.6",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0"
  },
  "keywords": [
    "plugin",
    "extensibility",
    "modular",
    "mnbara"
  ],
  "author": "mnbara team",
  "license": "MIT"
}
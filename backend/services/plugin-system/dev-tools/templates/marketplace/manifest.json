{
  "name": "{{pluginName}}",
  "version": "1.0.0",
  "description": "{{description}}",
  "main": "dist/index.js",
  "type": "custom",
  "author": "{{author}}",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@mnbara/plugin-core": "^1.0.0",
    "@mnbara/marketplace": "^1.0.0",
    "axios": "^1.3.0",
    "lodash": "^4.17.21"
  },
  "config": {
    "apiEndpoint": "string",
    "refreshInterval": "number",
    "maxProducts": "number",
    "categories": "array",
    "currency": "string"
  },
  "hooks": {
    "product:listed": "onProductListed",
    "product:sold": "onProductSold",
    "product:price-changed": "onPriceChanged",
    "marketplace:order-created": "onOrderCreated",
    "marketplace:order-completed": "onOrderCompleted",
    "marketplace:review-added": "onReviewAdded"
  },
  "permissions": [
    "marketplace:read",
    "marketplace:write",
    "product:read",
    "product:write",
    "order:read",
    "order:write"
  ],
  "resources": {
    "memory": "512MB",
    "cpu": "1000m",
    "storage": "2GB"
  }
}
{
  "name": "@mnbara/plugin-dev-tools",
  "version": "1.0.0",
  "description": "Development tools for plugin development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "plugin-dev": "dist/cli/plugin-dev.js"
  },
  "scripts": {
    "build": "tsc",
    "build:simple": "tsc cli/simple-plugin-dev.ts --outDir dist --target ES2020 --module commonjs",
    "dev": "ts-node src/index.ts",
    "cli": "node dist/simple-plugin-dev.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "clean": "rimraf dist",
    "prepare": "npm run build:simple"
  },
  "dependencies": {
    "@mnbara/plugin-core": "^1.0.0",
    "@mnbara/plugin-manager": "^1.0.0",
    "@mnbara/hook-system": "^1.0.0",
    "@mnbara/plugin-registry": "^1.0.0",
    "@mnbara/plugin-marketplace": "^1.0.0",
    "@mnbara/plugin-testing": "^1.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "commander": "^9.4.1",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.5",
    "fs-extra": "^11.1.0",
    "glob": "^8.1.0",
    "semver": "^7.3.8"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/express": "^4.17.15",
    "@types/cors": "^2.8.13",
    "@types/inquirer": "^8.2.5",
    "@types/fs-extra": "^11.0.1",
    "@types/glob": "^8.0.0",
    "@types/semver": "^7.3.13",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "eslint": "^8.32.0",
    "jest": "^29.3.1",
    "@types/jest": "^29.2.5",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4",
    "rimraf": "^4.1.2"
  },
  "keywords": [
    "plugin",
    "development",
    "tools",
    "cli",
    "scaffold",
    "generator",
    "documentation",
    "testing",
    "build",
    "deploy"
  ],
  "author": "Mbara Platform Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnara-platform/plugin-dev-tools.git"
  },
  "bugs": {
    "url": "https://github.com/mnara-platform/plugin-dev-tools/issues"
  },
  "homepage": "https://github.com/mnara-platform/plugin-dev-tools#readme",
  "engines": {
    "node": ">=14.0.0"
  }
}
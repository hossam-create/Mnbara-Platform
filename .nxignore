.git
.gitignore
.gitattributes

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
.env.local
.env.*.local

# Dependencies
node_modules
dist
build

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
Thumbs.db
.DS_Store

# Documentation
docs
README.md
CONTRIBUTING.md

# Archive
archive

# Infrastructure (usually doesn't affect builds)
infrastructure
k8s
docker-compose*.yml

# Test coverage
coverage
.nyc_output

# Temporary files
tmp
temp
*.tmp

# ============================================
# Mnbara Platform — Root Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ============================================
# DATABASE
# ============================================
POSTGRES_DB=mnbarh
POSTGRES_USER=mnbarh
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://mnbarh:CHANGE_ME@localhost:5432/mnbarh

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT (shared across all services)
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# CANONICAL PORT MAP
# ============================================
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
PRODUCT_SERVICE_PORT=3004
WALLET_SERVICE_PORT=3005
ORDERS_SERVICE_PORT=3006
ESCROW_SERVICE_PORT=3007
SETTLEMENT_SERVICE_PORT=3008
TRIPS_SERVICE_PORT=3009
MATCHING_SERVICE_PORT=3010
NOTIFICATION_SERVICE_PORT=3011
SUBSCRIPTION_SERVICE_PORT=3012
CART_SERVICE_PORT=3013
FEATURE_MANAGEMENT_SERVICE_PORT=3014
ADMIN_SERVICE_PORT=3015
COUNTRY_LAYER_SERVICE_PORT=3016

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# ============================================
# CORS — comma-separated allowed origins
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# THIRD-PARTY APIs (fill with real keys)
# ============================================
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME

# ============================================
# AI FEATURE FLAGS
# ============================================
FF_AI_CORE_ENABLED=false
FF_AI_INTENT_CLASSIFICATION=false
FF_AI_TRUST_SCORING=false
FF_AI_RISK_ASSESSMENT=false

# ============================================
# KYC CONFIGURATION
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

KYC_STORAGE_BUCKET=traveler-kyc-documents
KYC_STORAGE_ENDPOINT=http://localhost:9000
KYC_STORAGE_ACCESS_KEY=CHANGE_ME
KYC_STORAGE_SECRET_KEY=CHANGE_ME
KYC_DOCUMENT_ENCRYPTION_KEY=CHANGE_ME

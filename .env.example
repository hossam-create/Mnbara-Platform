# ============================================================================
# Mnbara Platform - Monorepo Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# This file contains all environment variables for the entire monorepo

# ============================================================================
# GENERAL CONFIGURATION
# ============================================================================

# Node Environment (development, staging, production)
NODE_ENV=development

# Application Name
APP_NAME=Mnbara Platform

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://mnbara:password@localhost:5432/mnbara_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=mnbara
DB_PASSWORD=password
DB_NAME=mnbara_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# API GATEWAY CONFIGURATION
# ============================================================================

API_GATEWAY_PORT=3000
API_GATEWAY_HOST=localhost
API_BASE_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRY=24h
JWT_ALGORITHM=HS256

# Refresh Token
REFRESH_TOKEN_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
REFRESH_TOKEN_EXPIRY=7d

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_MAX_AGE=86400000

# Password Hashing
BCRYPT_ROUNDS=10

# ============================================================================
# CORE SERVICES CONFIGURATION
# ============================================================================

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_HOST=localhost

# User Service
USER_SERVICE_PORT=3002
USER_SERVICE_URL=http://localhost:3002
USER_SERVICE_HOST=localhost

# Notification Service
NOTIFICATION_SERVICE_PORT=3003
NOTIFICATION_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_HOST=localhost

# ============================================================================
# MARKETPLACE SERVICES CONFIGURATION
# ============================================================================

# Product Service
PRODUCT_SERVICE_PORT=3004
PRODUCT_SERVICE_URL=http://localhost:3004
PRODUCT_SERVICE_HOST=localhost

# Order Service
ORDER_SERVICE_PORT=3005
ORDER_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_HOST=localhost

# Cart Service
CART_SERVICE_PORT=3006
CART_SERVICE_URL=http://localhost:3006
CART_SERVICE_HOST=localhost

# ============================================================================
# CROWDSHIPPING SERVICES CONFIGURATION
# ============================================================================

# Trips Service
TRIPS_SERVICE_PORT=3007
TRIPS_SERVICE_URL=http://localhost:3007
TRIPS_SERVICE_HOST=localhost

# Matching Service
MATCHING_SERVICE_PORT=3008
MATCHING_SERVICE_URL=http://localhost:3008
MATCHING_SERVICE_HOST=localhost

# ============================================================================
# FINANCIAL SERVICES CONFIGURATION
# ============================================================================

# Payment Service
PAYMENT_SERVICE_PORT=3009
PAYMENT_SERVICE_URL=http://localhost:3009
PAYMENT_SERVICE_HOST=localhost

# Wallet Service
WALLET_SERVICE_PORT=3010
WALLET_SERVICE_URL=http://localhost:3010
WALLET_SERVICE_HOST=localhost

# Escrow Service
ESCROW_SERVICE_PORT=3011
ESCROW_SERVICE_URL=http://localhost:3011
ESCROW_SERVICE_HOST=localhost

# Settlement Service
SETTLEMENT_SERVICE_PORT=3012
SETTLEMENT_SERVICE_URL=http://localhost:3012
SETTLEMENT_SERVICE_HOST=localhost

# ============================================================================
# EXTERNAL SERVICES & INTEGRATIONS
# ============================================================================

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# SendGrid Email Service
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@mnbara.com
SENDGRID_FROM_NAME=Mnbara Platform

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mnbara-uploads

# ============================================================================
# EXTERNAL APIS - MAPS & GEOCODING
# ============================================================================

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Mapbox
MAPBOX_API_KEY=your_mapbox_api_key

# HERE Maps
HERE_MAPS_API_KEY=your_here_maps_api_key

# ============================================================================
# EXTERNAL APIS - PAYMENTS & CURRENCY
# ============================================================================

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Wise (TransferWise)
WISE_API_KEY=your_wise_api_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ============================================================================
# EXTERNAL APIS - NOTIFICATIONS
# ============================================================================

# Firebase (for mobile push notifications)
FIREBASE_PROJECT_ID=mnbara-xxx
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mnbara-xxx.iam.gserviceaccount.com
FIREBASE_SERVER_KEY=your_firebase_server_key

# Vonage (Nexmo)
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret

# ============================================================================
# EXTERNAL APIS - VALIDATION
# ============================================================================

# Email Validation
EMAIL_VALIDATION_API_KEY=your_email_validation_api_key

# Phone Validation (Numverify)
PHONE_VALIDATION_API_KEY=your_phone_validation_api_key

# Address Validation
ADDRESS_VALIDATION_API_KEY=your_address_validation_api_key

# ============================================================================
# EXTERNAL APIS - DATA & INFORMATION
# ============================================================================

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key

# ============================================================================
# EXTERNAL APIS - GLOBAL SETTINGS
# ============================================================================

# Enable/Disable API caching
ENABLE_API_CACHE=true

# ============================================================================
# FRONTEND APPLICATIONS CONFIGURATION
# ============================================================================

# Web Application
WEB_APP_PORT=5173
WEB_APP_URL=http://localhost:5173

# Mobile Application API
MOBILE_API_URL=http://localhost:3000/api/v1

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILES=7
LOG_MAX_SIZE=10m

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================================================
# MESSAGE QUEUE & EVENT BUS
# ============================================================================

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Development Features
ENABLE_MOCK_PAYMENTS=true
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_SWAGGER_DOCS=true

# Feature Toggles
FEATURE_CROWDSHIPPING_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_WALLET_ENABLED=true
FEATURE_ESCROW_ENABLED=true

# ============================================================================
# NX MONOREPO CONFIGURATION
# ============================================================================

# Nx Cache
NX_CACHE_DIRECTORY=.nx/cache
NX_DAEMON=true
NX_PARALLEL=3

# Nx Cloud (optional - for distributed caching)
NX_CLOUD_ACCESS_TOKEN=your_nx_cloud_token_here
NX_CLOUD_DISTRIBUTED_EXECUTION=false

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Test Database
TEST_DATABASE_URL=postgresql://mnbara:password@localhost:5432/mnbara_test
TEST_REDIS_URL=redis://localhost:6379/1

# Test Configuration
TEST_TIMEOUT=30000
TEST_COVERAGE_THRESHOLD=80

# ============================================================================
# DOCKER & DEPLOYMENT
# ============================================================================

# Docker Configuration
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_PREFIX=mnbara

# Kubernetes
K8S_NAMESPACE=mnbara-dev
K8S_CLUSTER=mnbara-cluster

# ============================================================================
# SECURITY & COMPLIANCE
# ============================================================================

# Encryption Keys
ENCRYPTION_KEY=your-encryption-key-32-chars-min
ENCRYPTION_ALGORITHM=aes-256-gcm

# API Keys
INTERNAL_API_KEY=your-internal-api-key-change-in-production

# Security Headers
HELMET_ENABLED=true
CSRF_ENABLED=true

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================

# Caching
CACHE_TTL=3600
CACHE_ENABLED=true

# Request Timeout
REQUEST_TIMEOUT=30000

# Max Upload Size
MAX_UPLOAD_SIZE=10mb

# ============================================================================
# LOCALIZATION
# ============================================================================

# Default Language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar,fr

# Timezone
DEFAULT_TIMEZONE=UTC

# ============================================================================
# BUSINESS CONFIGURATION
# ============================================================================

# Currency
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,SAR,AED

# Commission Rates (in percentage)
PLATFORM_COMMISSION_RATE=5
PAYMENT_PROCESSING_FEE=2.9

# Escrow Configuration
ESCROW_RELEASE_DELAY_HOURS=24
SECURITY_DEPOSIT_PERCENTAGE=10

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Hot Reload
HOT_RELOAD_ENABLED=true

# Source Maps
GENERATE_SOURCEMAP=true

# Debug Mode
DEBUG=mnbara:*

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. Update all "your_*_here" placeholders with actual values
# 3. Use strong, unique secrets for production environments
# 4. Rotate secrets regularly in production
# 5. Use environment-specific .env files (.env.development, .env.staging, .env.production)

{
  "name": "@mnbarh/integration-tests",
  "version": "1.0.0",
  "description": "Cross-service integration tests for Mnbara Platform",
  "scripts": {
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:contracts": "jest --testPathPattern=contracts",
    "test:all": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest --testPathPattern=integration/api",
    "test:services": "jest --testPathPattern=integration/services",
    "test:parallel": "jest --maxWorkers=4"
  },
  "dependencies": {
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nock": "^13.4.0",
    "supertest": "^6.3.3",
    "testcontainers": "^10.2.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "integration-tests",
    "e2e-tests",
    "mnbara",
    "microservices"
  ],
  "license": "MIT"
}

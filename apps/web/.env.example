# ============================================================================
# Frontend Web App Configuration - apps/web
# ============================================================================
# This file contains environment variables for the Next.js 15 web application
# Copy this file to .env.local and update values for your environment
# Note: Variables prefixed with VITE_ are exposed to the browser

# ============================================================================
# GENERAL CONFIGURATION
# ============================================================================

# Node Environment (development, staging, production)
NODE_ENV=development

# Application Name
NEXT_PUBLIC_APP_NAME=Mnbara Platform

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API Gateway (canonical port: 3000)
VITE_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Service URLs (for server-side requests)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3005
CART_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3009
WALLET_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3003

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
NEXT_PUBLIC_JWT_ALGORITHM=HS256

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production

# ============================================================================
# EXTERNAL SERVICES & INTEGRATIONS
# ============================================================================

# Stripe Payment Gateway (public key exposed to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# SendGrid Email Service
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@mnbara.com

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mnbara-uploads

# Google Maps API (public key exposed to browser)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase (for mobile push notifications)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mnbara-xxx
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mnbara-xxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mnbara-xxx.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# ============================================================================
# FRONTEND APPLICATIONS CONFIGURATION
# ============================================================================

# Web Application Port
NEXT_PUBLIC_WEB_APP_PORT=5173
NEXT_PUBLIC_WEB_APP_URL=http://localhost:5173

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Logging Configuration
NEXT_PUBLIC_LOG_LEVEL=debug

# Sentry Error Tracking (public DSN exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Development Features
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=true
NEXT_PUBLIC_ENABLE_DEBUG_ENDPOINTS=true
NEXT_PUBLIC_ENABLE_SWAGGER_DOCS=true

# Feature Toggles
NEXT_PUBLIC_FEATURE_CROWDSHIPPING_ENABLED=true
NEXT_PUBLIC_FEATURE_MARKETPLACE_ENABLED=true
NEXT_PUBLIC_FEATURE_WALLET_ENABLED=true
NEXT_PUBLIC_FEATURE_ESCROW_ENABLED=true

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================

# Caching
NEXT_PUBLIC_CACHE_TTL=3600
NEXT_PUBLIC_CACHE_ENABLED=true

# Request Timeout
NEXT_PUBLIC_REQUEST_TIMEOUT=30000

# Max Upload Size
NEXT_PUBLIC_MAX_UPLOAD_SIZE=10mb

# ============================================================================
# LOCALIZATION
# ============================================================================

# Default Language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,ar,fr

# Timezone
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC

# ============================================================================
# BUSINESS CONFIGURATION
# ============================================================================

# Currency
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_SUPPORTED_CURRENCIES=USD,EUR,GBP,SAR,AED

# Commission Rates (in percentage)
NEXT_PUBLIC_PLATFORM_COMMISSION_RATE=5
NEXT_PUBLIC_PAYMENT_PROCESSING_FEE=2.9

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Hot Reload
NEXT_PUBLIC_HOT_RELOAD_ENABLED=true

# Source Maps
GENERATE_SOURCEMAP=true

# Debug Mode
DEBUG=mnbara:*

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit the actual .env.local file to version control
# 2. Update all "your_*_here" placeholders with actual values
# 3. Use strong, unique secrets for production environments
# 4. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# 5. Variables prefixed with VITE_ are for Vite compatibility
# 6. Rotate secrets regularly in production
# 7. Use environment-specific files (.env.local, .env.staging, .env.production)
{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "node",
    "allowJs": true,
    "jsx": "react-native",
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    
    /* React Native Globals */
    "types": ["react-native", "node"],
    
    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    
    /* Additional Checks */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    
    /* Module Resolution Options */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@core/*": ["src/core/*"],
      "@domain/*": ["src/domain/*"],
      "@data/*": ["src/data/*"],
      "@features/*": ["src/features/*"],
      "@navigation/*": ["src/navigation/*"],
      "@theme/*": ["src/theme/*"],
      "@store/*": ["src/store/*"],
      "@config/*": ["src/config/*"],
      "@utils/*": ["src/core/utils/*"],
      "@mnbara/types": ["../../packages/types/src/index.ts"],
      "@mnbara/types/*": ["../../packages/types/src/*"],
      "@mnbara/utils": ["../../packages/utils/src/index.ts"],
      "@mnbara/utils/*": ["../../packages/utils/src/*"],
      "@mnbara/api-client": ["../../packages/api-client/src/index.ts"],
      "@mnbara/api-client/*": ["../../packages/api-client/src/*"],
      "@mnbara/validation": ["../../packages/validation/src/index.ts"],
      "@mnbara/validation/*": ["../../packages/validation/src/*"]
    },
    
    /* Experimental Options */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    
    /* Skip lib check */
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "*.ts",
    "*.tsx",
    "index.js",
    "metro.config.js",
    "jest.config.js"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "build",
    "coverage"
  ]
}

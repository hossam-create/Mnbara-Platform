# ============================================================================
# Mnbara Mobile App - Environment Variables
# ============================================================================
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the appropriate values for each environment.
# ============================================================================

# API Configuration
# Base URL for all API requests
EXPO_PUBLIC_API_BASE_URL=https://api.mnbara.com/v1

# WebSocket URL for real-time features (chat, notifications, live tracking)
EXPO_PUBLIC_SOCKET_URL=wss://socket.mnbara.com

# WebSocket port (if different from default)
EXPO_PUBLIC_WS_PORT=443

# ============================================================================
# Firebase Configuration
# Required for authentication, messaging, analytics, and crash reporting
# Get these values from Firebase Console: https://console.firebase.google.com
# ============================================================================

# Firebase API Key
FIREBASE_API_KEY=xxx

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=mnbara.firebaseapp.com

# Firebase Project ID
FIREBASE_PROJECT_ID=mnbara-xxx

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=mnbara-xxx.appspot.com

# Firebase Cloud Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=xxx

# Firebase App ID
FIREBASE_APP_ID=xxx

# ============================================================================
# Google Sign-In Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com
# ============================================================================

# Google Sign-In Client ID for iOS
GOOGLE_SIGN_IN_IOS_CLIENT_ID=xxx

# Google Sign-In Client ID for Android
GOOGLE_SIGN_IN_ANDROID_CLIENT_ID=xxx

# ============================================================================
# Google Maps Configuration
# Get API keys from Google Cloud Console
# ============================================================================

# Google Maps API Key for iOS
GOOGLE_MAPS_IOS_API_KEY=xxx

# Google Maps API Key for Android
GOOGLE_MAPS_ANDROID_API_KEY=xxx

# ============================================================================
# Stripe Configuration
# Get from Stripe Dashboard: https://dashboard.stripe.com
# ============================================================================

# Stripe Publishable Key (public key, safe to expose)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ============================================================================
# App Configuration
# ============================================================================

# Application environment (development, staging, production)
APP_ENV=development

# Application name
APP_NAME=Mnbara
